local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local isFarming = false
local farmLoop = nil

-- Функция, которая имитирует фарм: полёт, ноклип, телепорт, трата денег
local function farmAction()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    -- 1. Бесконечный полёт (BodyVelocity)
    local bv = hrp:FindFirstChild("FarmBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmBV"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.P = 1e6
        bv.Parent = hrp
    end
    bv.Velocity = Vector3.new(math.random(-50, 50), math.random(-20, 20), math.random(-50, 50)).Unit * 200

    -- 2. Ноклип (отключение коллизий через PlatformStand)
    hum.PlatformStand = true
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)

    -- 3. Телепорт в случайную точку карты (раз в несколько итераций)
    if math.random(1, 3) == 1 then
        local x = math.random(-6000, 6000)
        local z = math.random(-6000, 6000)
        local y = 30 + math.random(0, 50)
        hrp.CFrame = CFrame.new(x, y, z)
    end

    -- 4. Трата игровых денег (имитация покупок через клики по предметам в магазине)
    local shop = Workspace:FindFirstChild("Shop") or ReplicatedStorage:FindFirstChild("Shop")
    if shop then
        local items = shop:GetChildren()
        if #items > 0 then
            local item = items[math.random(1, #items)]
            if item and item:IsA("Model") then
                local click = item:FindFirstChild("ClickDetector") or item:FindFirstChildWhichIsA("ClickDetector")
                if click then
                    pcall(function()
                        click:FireClick(Player.Mouse)
                    end)
                end
            end
        end
    end

    -- Дополнительно: попытка купить что-то через RemoteEvent (если есть)
    local buyEvent = ReplicatedStorage:FindFirstChild("BuyItem") or ReplicatedStorage:FindFirstChild("Purchase")
    if buyEvent and buyEvent:IsA("RemoteEvent") then
        pcall(function()
            buyEvent:FireServer("buy", math.random(1, 999))
        end)
    end
end

local function startFarm()
    if isFarming then return end
    isFarming = true

    -- Чёрный экран с загрузкой
    local black = Instance.new("Frame")
    black.Name = "BlackScreen"
    black.Size = UDim2.new(1, 0, 1, 0)
    black.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    black.BorderSizePixel = 0
    black.ZIndex = 999
    black.Parent = Player:WaitForChild("PlayerGui")

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(0, 300, 0, 50)
    text.Position = UDim2.new(0.5, -150, 0.5, -25)
    text.BackgroundTransparency = 1
    text.Text = "ФАРМ АКТИВИРОВАН"
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextSize = 24
    text.Font = Enum.Font.GothamBold
    text.ZIndex = 1000
    text.Parent = black

    -- Основной цикл фарма
    farmLoop = RunService.Heartbeat:Connect(function()
        if isFarming then
            pcall(farmAction)
        end
    end)

    -- Дополнительно отдельный поток для более частых действий
    task.spawn(function()
        while isFarming do
            task.wait(math.random(1, 3))
            if isFarming then
                pcall(farmAction)
            end
        end
    end)
end

local function stopFarm()
    isFarming = false
    if farmLoop then
        farmLoop:Disconnect()
        farmLoop = nil
    end
    -- Удалить чёрный экран
    local gui = Player:FindFirstChild("PlayerGui")
    if gui then
        local bs = gui:FindFirstChild("BlackScreen")
        if bs then bs:Destroy() end
    end
    -- Отключить полёт и ноклип
    local char = Player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("FarmBV")
            if bv then bv:Destroy() end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

