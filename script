-- ------------------------------------------------------------
--  Логгер RemoteEvent (для выяснения правильного события)
-- ------------------------------------------------------------
local function startLogger()
    print("🔍 Логгер запущен. Подойдите к объекту, нажмите E вручную, смотрите консоль (F9).")
    local function hook(obj)
        if obj:IsA("RemoteEvent") then
            local old = obj.FireServer
            obj.FireServer = function(self, ...)
                print("🔥 RemoteEvent:", obj.Name, "Аргументы:", ...)
                return old(self, ...)
            end
        elseif obj:IsA("RemoteFunction") then
            local old = obj.InvokeServer
            obj.InvokeServer = function(self, ...)
                print("⚡ RemoteFunction:", obj.Name, "Аргументы:", ...)
                return old(self, ...)
            end
        end
    end
    for _, service in ipairs({ReplicatedStorage, game:GetService("Workspace"), game:GetService("Players")}) do
        for _, child in ipairs(service:GetDescendants()) do
            hook(child)
        end
    end
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.E then
            print("🔑 Вы нажали E вручную")
        end
    end)
end
startLogger()

-- ------------------------------------------------------------
--  Нажатие E (три способа)
-- ------------------------------------------------------------
local function pressE(holdDuration)
    local success = false
    pcall(function()
        VirtualInput:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(holdDuration)
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        success = true
    end)
    if success then print("✅ E через VirtualInputManager") return true end

    if syn and syn.input then
        pcall(function()
            syn.input(true, Enum.KeyCode.E, game)
            task.wait(holdDuration)
            syn.input(false, Enum.KeyCode.E, game)
            success = true
        end)
        if success then print("✅ E через syn.input") return true end
    end

    if keypress then
        pcall(function()
            keypress(Enum.KeyCode.E)
            task.wait(holdDuration)
            keyrelease(Enum.KeyCode.E)
            success = true
        end)
        if success then print("✅ E через keypress") return true end
    end

    print("❌ Все способы нажатия E не сработали")
    return false
end

-- ------------------------------------------------------------
--  Действие при прибытии
-- ------------------------------------------------------------
local function performAction(action)
    if not action then return end
    local duration = action.duration or 2
    local repeats = action.repeats or 1
    local totalPause = action.totalPause or (duration * repeats)

    for i = 1, repeats do
        if not isFarming or stopRequested then break end
        pressE(duration)
        if not isFarming or stopRequested then break end
        if i < repeats then
            task.wait(0.2)
        end
    end

    local remaining = totalPause - (duration * repeats)
    if remaining > 0 and isFarming and not stopRequested then
        task.wait(remaining)
    end
end

-- ------------------------------------------------------------
--  Перемещение (TweenService)
-- ------------------------------------------------------------
local function flyToPoint(targetPos, speed)
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
    end

    local currentCF = hrp.CFrame
    local targetCF = CFrame.new(targetPos) * CFrame.Angles(0, currentCF.Y, 0)
    local distance = (targetPos - hrp.Position).Magnitude
    local duration = distance / speed
    if duration < 0.1 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = { CFrame = targetCF }
    currentTween = TweenService:Create(hrp, tweenInfo, goal)

    local completed = false
    currentTween.Completed:Connect(function() completed = true end)
    currentTween:Play()

    while not completed and isFarming and not stopRequested do
        task.wait(0.05)
    end

    if stopRequested then
        currentTween:Cancel()
        return false
    end
    return true
end

-- ------------------------------------------------------------
--  Анти-AFK (без мыши, только микродвижение персонажа)
-- ------------------------------------------------------------
local function startAfk()
    if afkThread then return end
    isAfkEnabled = true
    afkThread = task.spawn(function()
        while isAfkEnabled do
            task.wait(15)
            if not isAfkEnabled then break end
            local char = Player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos = hrp.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0.5, 0, 0))
                    task.wait(0.05)
                    hrp.CFrame = CFrame.new(pos)
                end
            end
        end
    end)
end

local function stopAfk()
    isAfkEnabled = false
    if afkThread then
        task.cancel(afkThread)
        afkThread = nil
    end
end

-- ------------------------------------------------------------
--  Основной цикл фарма
-- ------------------------------------------------------------
local function farmCycle()
    while isFarming and not stopRequested do
        for _, step in ipairs(route) do
            if not isFarming or stopRequested then break end
            local ok = flyToPoint(step.pos, FLY_SPEED)
            if not ok then break end
            if step.holdAction and isFarming and not stopRequested then
                performAction(step.holdAction)
            end
            task.wait(0.2)
        end
        if isFarming and not stopRequested then
            task.wait(0.5)
        end
    end
end

-- ------------------------------------------------------------
--  Управление фармом
-- ------------------------------------------------------------
local function startFarm()
    if isFarming then return end
    isFarming = true
    stopRequested = false
    task.spawn(farmCycle)
end

local function stopFarm()
    if not isFarming then return end
    isFarming = false
    stopRequested = true
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

