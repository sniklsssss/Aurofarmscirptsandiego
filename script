-- ------------------------------------------------------------
--  Состояние фарма
-- ------------------------------------------------------------
local isRunning = false
local currentStep = 1          -- индекс текущего шага в маршруте
local direction = 1            -- 1 – вперёд, -1 – назад (но мы всегда идём по кругу, поэтому direction не используется)
local stopRequested = false
local currentTween = nil
local holdCoroutine = nil

-- ------------------------------------------------------------
--  Функции управления персонажем
-- ------------------------------------------------------------
local function setPlatformMode(enabled)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = enabled
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, not enabled)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, not enabled)
    end
end

-- Плавное перемещение к точке
local function moveToPoint(targetPos)
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (targetPos - hrp.Position).Magnitude
    if distance < 0.5 then
        return true -- уже на месте
    end

    local duration = distance / MOVE_SPEED
    if duration < 0.1 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = { CFrame = CFrame.new(targetPos) }
    currentTween = TweenService:Create(hrp, tweenInfo, goal)

    local completed = false
    currentTween.Completed:Connect(function()
        completed = true
    end)

    currentTween:Play()

    -- Ждём завершения или остановки
    while not completed and isRunning and not stopRequested do
        task.wait(0.05)
    end

    if stopRequested then
        currentTween:Cancel()
        return false
    end

    return true
end

-- Выполнение зажатия кнопки (повторы с паузами)
local function performHoldAction(action)
    if not action then return end
    local duration = action.duration or 2
    local repeats = action.repeats or 1
    local totalPause = action.totalPause or (duration * repeats)

    for i = 1, repeats do
        if not isRunning or stopRequested then break end
        -- Зажать
        VirtualInput:SendKeyEvent(true, KEY_E, false, game)
        task.wait(duration)
        if not isRunning or stopRequested then
            VirtualInput:SendKeyEvent(false, KEY_E, false, game)
            break
        end
        -- Отпустить
        VirtualInput:SendKeyEvent(false, KEY_E, false, game)
        -- Если не последний повтор, небольшая пауза (0.2 сек)
        if i < repeats then
            task.wait(0.2)
        end
    end

    -- Дожидаемся оставшейся части общей паузы (если totalPause больше, чем уже прошло)
    local elapsed = duration * repeats
    local remaining = totalPause - elapsed
    if remaining > 0 and isRunning and not stopRequested then
        task.wait(remaining)
    end
end

-- ------------------------------------------------------------
--  Основной цикл фарма
-- ------------------------------------------------------------
local function farmCycle()
    while isRunning and not stopRequested do
        -- Проходим все шаги маршрута
        for i = 1, #route do
            if not isRunning or stopRequested then break end

            local step = route[i]
            -- Двигаемся к точке
            local ok = moveToPoint(step.pos)
            if not ok then break end

            -- Если есть действие после прибытия
            if step.holdAction and isRunning and not stopRequested then
                performHoldAction(step.holdAction)
            end

            -- Небольшая задержка между точками
            task.wait(0.1)
        end

        -- Если дошли до конца и не остановлены, начинаем сначала
        if isRunning and not stopRequested then
            -- Можно добавить паузу перед новым кругом (опционально)
            task.wait(0.5)
        end
    end
end

-- ------------------------------------------------------------
--  Запуск / остановка фарма
-- ------------------------------------------------------------
local function startFarm()
    if isRunning then return end
    isRunning = true
    stopRequested = false

    -- Подготовка персонажа
    setPlatformMode(true)

    -- Запускаем цикл в отдельном потоке
    task.spawn(farmCycle)
end

local function stopFarm()
    if not isRunning then return end
    isRunning = false
    stopRequested = true

    -- Отжимаем клавишу, если зажата
    VirtualInput:SendKeyEvent(false, KEY_E, false, game)

    -- Отменяем твин
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end

    -- Отменяем корутину ожидания (если есть)
    if holdCoroutine then
        task.cancel(holdCoroutine)
        holdCoroutine = nil
    end

    -- Возвращаем управление персонажу
    setPlatformMode(false)
end

