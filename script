-- Настройки
local MOVE_SPEED = 25   -- студий в секунду (бег)
local HOLD_TIME = 3     -- секунд зажатия клавиши

-- Состояние
local isRunning = false
local currentIndex = 1
local direction = 1   -- 1 - вперёд, -1 - назад
local currentTween = nil
local holdCoroutine = nil
local stopRequested = false

-- Функция плавного перемещения к точке
local function moveToPoint(targetPos)
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return false end

    -- Включаем режим, чтобы персонаж не падал и не мешал
    hum.PlatformStand = true
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)

    local distance = (targetPos - hrp.Position).Magnitude
    if distance < 0.5 then
        -- Уже на месте
        return true
    end

    local duration = distance / MOVE_SPEED
    if duration < 0.1 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    local goal = {CFrame = CFrame.new(targetPos)}
    currentTween = TweenService:Create(hrp, tweenInfo, goal)

    local completed = false
    currentTween.Completed:Connect(function()
        completed = true
    end)

    currentTween:Play()

    -- Ждём завершения или остановки
    while not completed and isRunning and not stopRequested do
        task.wait(0.1)
    end

    if stopRequested then
        currentTween:Cancel()
        return false
    end

    return true
end

-- Функция имитации зажатия клавиши (например, E)
local function holdInteraction()
    if not isRunning or stopRequested then return end
    -- Эмулируем нажатие клавиши E (код 69)
    VirtualInput:SendKeyEvent(true, 69, false, game)
    task.wait(HOLD_TIME)
    if not isRunning or stopRequested then
        VirtualInput:SendKeyEvent(false, 69, false, game)
        return
    end
    VirtualInput:SendKeyEvent(false, 69, false, game)
end

-- Основной цикл фарма
local function farmLoop()
    while isRunning and not stopRequested do
        -- Двигаемся к текущей точке
        local target = points[currentIndex]
        local success = moveToPoint(target)
        if not success then
            -- Если остановили, выходим
            break
        end

        if not isRunning or stopRequested then break end

        -- Достигли точки – зажимаем кнопку
        holdCoroutine = task.spawn(holdInteraction)

        -- Ждём окончания зажатия
        while holdCoroutine and coroutine.status(holdCoroutine) ~= "dead" do
            task.wait(0.1)
            if not isRunning or stopRequested then
                -- Принудительно отжимаем
                VirtualInput:SendKeyEvent(false, 69, false, game)
                break
            end
        end

        if not isRunning or stopRequested then break end

        -- Переход к следующей точке
        local nextIndex = currentIndex + direction
        if nextIndex > #points then
            direction = -1
            nextIndex = currentIndex - 1
        elseif nextIndex < 1 then
            direction = 1
            nextIndex = currentIndex + 1
        end
        currentIndex = nextIndex
    end
end

-- Запуск / остановка
local function startFarm()
    if isRunning then return end
    isRunning = true
    stopRequested = false

    -- Сброс индекса и направления (для начала с первой точки)
    currentIndex = 1
    direction = 1

    -- Отключаем управление персонажем
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = true
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
        end
    end

    task.spawn(farmLoop)
end

local function stopFarm()
    if not isRunning then return end
    isRunning = false
    stopRequested = true
    -- Отжимаем клавишу, если зажата
    VirtualInput:SendKeyEvent(false, 69, false, game)
    -- Отменяем текущий твин
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    -- Отменяем корутину ожидания
    if holdCoroutine then
        task.cancel(holdCoroutine)
        holdCoroutine = nil
    end
    -- Восстанавливаем управление
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

