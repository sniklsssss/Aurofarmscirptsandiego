local function teleportRandom()
    local char = Player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local x = math.random(-5000, 5000)
    local z = math.random(-5000, 5000)
    local y = 50
    local pos = Vector3.new(x, y, z)
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(pos)
    else
        char:MoveTo(pos)
    end
    
    humanoid.PlatformStand = true
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
    
    task.spawn(function()
        for i = 1, 5 do
            task.wait(0.05)
            if root then
                local shake = pos + Vector3.new(math.random(-10,10), math.random(-5,5), math.random(-10,10))
                root.CFrame = CFrame.new(shake)
            end
        end
    end)
    
    local bv = char:FindFirstChild("FarmVelocity")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmVelocity"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.P = 1e5
        bv.Parent = root or char
    end
    local dir = Vector3.new(math.random(-20,20), math.random(-5,5), math.random(-20,20)).Unit
    bv.Velocity = dir * 80
end

local function startFarming()
    if isFarming then return end
    isFarming = true
    
    local blackScreen = Instance.new("Frame")
    blackScreen.Name = "BlackScreen"
    blackScreen.Size = UDim2.new(1, 0, 1, 0)
    blackScreen.BackgroundColor3 = Color3.fromRGB(0,0,0)
    blackScreen.BorderSizePixel = 0
    blackScreen.ZIndex = 999
    blackScreen.Parent = Player:WaitForChild("PlayerGui")
    
    local loadLabel = Instance.new("TextLabel")
    loadLabel.Size = UDim2.new(0, 300, 0, 50)
    loadLabel.Position = UDim2.new(0.5, -150, 0.5, -25)
    loadLabel.BackgroundTransparency = 1
    loadLabel.Text = "LOADING FARM..."
    loadLabel.TextColor3 = Color3.fromRGB(255,255,255)
    loadLabel.TextSize = 24
    loadLabel.Font = Enum.Font.GothamBold
    loadLabel.ZIndex = 1000
    loadLabel.Parent = blackScreen
    
    local spinner = Instance.new("Frame")
    spinner.Size = UDim2.new(0, 50, 0, 50)
    spinner.Position = UDim2.new(0.5, -25, 0.5, -80)
    spinner.BackgroundColor3 = Color3.fromRGB(255,255,255)
    spinner.BackgroundTransparency = 0.8
    spinner.ZIndex = 1000
    spinner.Parent = blackScreen
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = spinner
    
    local spinTween
    local function spin()
        spinTween = TweenService:Create(spinner, TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, true), {Rotation = 360})
        spinTween:Play()
    end
    spin()
    
    farmLoop = task.spawn(function()
        while isFarming do
            teleportRandom()
            local waitTime = math.random(2, 5)
            task.wait(waitTime)
            if math.random(1,3) == 1 then
                teleportRandom()
            end
        end
    end)
end

local function stopFarming()
    isFarming = false
    if farmLoop then
        task.cancel(farmLoop)
        farmLoop = nil
    end
    local gui = Player:FindFirstChild("PlayerGui")
    if gui then
        local bs = gui:FindFirstChild("BlackScreen")
        if bs then bs:Destroy() end
    end
    local char = Player.Character
    if char then
        local bv = char:FindFirstChild("FarmVelocity")
        if bv then bv:Destroy() end
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

