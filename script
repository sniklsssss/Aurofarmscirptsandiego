local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 400, 0, 600)
mainFrame.Position = UDim2.new(0.5, -200, 0.5, -300)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
mainFrame.BorderSizePixel = 0
mainFrame.ClipsDescendants = true
mainFrame.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = mainFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundTransparency = 1
title.Text = "ФАРМ ХАБ"
title.TextColor3 = Color3.fromRGB(100, 200, 255)
title.TextSize = 22
title.Font = Enum.Font.GothamBold
title.Parent = mainFrame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -20, 1, -80)
scroll.Position = UDim2.new(0, 10, 0, 60)
scroll.BackgroundTransparency = 1
scroll.CanvasSize = UDim2.new(0, 0, 0, 12 * 70)
scroll.ScrollBarThickness = 6
scroll.Parent = mainFrame

local moduleNames = {
    "Rings Farm", "Auto Monalis", "El Diablo Box", "Job Farm",
    "BoatFarm", "TruckFarm", "Money Duper", "Fly Hacker",
    "God Mode", "Kill Aura", "Speed Hack", "Auto Report"
}
local moduleStates = {}
local yOffset = 0

for _, name in ipairs(moduleNames) do
    local modFrame = Instance.new("Frame")
    modFrame.Size = UDim2.new(1, 0, 0, 60)
    modFrame.Position = UDim2.new(0, 0, 0, yOffset)
    modFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    modFrame.BorderSizePixel = 0
    modFrame.Parent = scroll
    local modCorner = Instance.new("UICorner")
    modCorner.CornerRadius = UDim.new(0, 6)
    modCorner.Parent = modFrame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.6, -10, 0, 25)
    nameLabel.Position = UDim2.new(0, 10, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 15
    nameLabel.Font = Enum.Font.GothamMedium
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = modFrame

    local stateBtn = Instance.new("TextButton")
    stateBtn.Size = UDim2.new(0, 80, 0, 30)
    stateBtn.Position = UDim2.new(0.7, 0, 0, 15)
    stateBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
    stateBtn.Text = "OFF"
    stateBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    stateBtn.TextSize = 14
    stateBtn.Font = Enum.Font.GothamBold
    stateBtn.Parent = modFrame
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = stateBtn

    moduleStates[name] = false

    stateBtn.MouseButton1Click:Connect(function()
        local state = not moduleStates[name]
        moduleStates[name] = state
        if state then
            stateBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            stateBtn.Text = "ON"
        else
            stateBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
            stateBtn.Text = "OFF"
        end

        local anyOn = false
        for _, v in pairs(moduleStates) do
            if v then anyOn = true; break end
        end

        if anyOn then
            if not isFarming then
                startFarm()
            end
        else
            if isFarming then
                stopFarm()
            end
        end
    end)

    yOffset = yOffset + 70
end

scroll.CanvasSize = UDim2.new(0, 0, 0, yOffset + 20)

-- Перетаскивание окна
local dragging = false
local dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)
mainFrame.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

print("✅ Фарм Хаб загружен. Включайте любой модуль для фарма.")
