local PAUSE_SECONDS = 10   -- пауза в каждой точке (сек)
local MOVE_SPEED = 16      -- скорость ходьбы (чем больше, тем быстрее)

-- Состояние
local isRunning = false
local stopRequested = false
local currentPointIndex = 1
local direction = 1  -- 1 вперёд, -1 назад
local afkTimer = 0

-- Функция для ожидания достижения точки
local function walkToPoint(targetPos)
    local char = Player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    -- Включаем обычный режим (не платформа)
    hum.PlatformStand = false
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)

    -- Начинаем движение
    hum:MoveTo(targetPos)
    hum.WalkSpeed = MOVE_SPEED

    -- Ждём, пока дойдёт или пока не остановят
    while isRunning and not stopRequested do
        local dist = (targetPos - hrp.Position).Magnitude
        if dist < 3 then
            return true
        end
        -- Если слишком далеко или застрял, повторяем MoveTo
        if hum.MoveDirection.Magnitude < 0.5 then
            hum:MoveTo(targetPos)
        end
        task.wait(0.2)
    end
    return false
end

-- Основной цикл
local function farmLoop()
    while isRunning and not stopRequested do
        -- Проходим все точки в текущем направлении
        for i = 1, #points do
            if not isRunning or stopRequested then break end
            local idx = currentPointIndex
            local target = points[idx]
            print("🚶 Иду к точке", idx, target)
            local ok = walkToPoint(target)
            if not ok then
                print("⚠️ Не удалось дойти до точки, перезапуск цикла")
                break
            end

            print("✅ Дошёл до точки", idx, "пауза", PAUSE_SECONDS, "сек")
            -- Пауза (имитация взаимодействия)
            local pauseStart = tick()
            while isRunning and not stopRequested and (tick() - pauseStart) < PAUSE_SECONDS do
                task.wait(0.1)
            end

            -- Переход к следующей точке с учётом направления
            local nextIdx = currentPointIndex + direction
            if nextIdx > #points then
                direction = -1
                nextIdx = currentPointIndex - 1
            elseif nextIdx < 1 then
                direction = 1
                nextIdx = currentPointIndex + 1
            end
            currentPointIndex = nextIdx
        end
        -- Если цикл завершён (дошли до конца и обратно), небольшой отдых
        if isRunning and not stopRequested then
            task.wait(0.5)
        end
    end
end

-- Запуск / остановка
local function startFarm()
    if isRunning then return end
    isRunning = true
    stopRequested = false
    -- Начинаем с первой точки
    currentPointIndex = 1
    direction = 1
    task.spawn(farmLoop)
    -- Запускаем анти-AFK
    task.spawn(function()
        while isRunning do
            task.wait(20)
            if not isRunning then break end
            -- Микродвижение персонажа, чтобы не выкинуло
            local char = Player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos = hrp.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0.3, 0, 0))
                    task.wait(0.05)
                    hrp.CFrame = CFrame.new(pos)
                end
            end
        end
    end)
    print("✅ Фарм запущен")
end

local function stopFarm()
    if not isRunning then return end
    isRunning = false
    stopRequested = true
    -- Останавливаем персонажа
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum:MoveTo(char.HumanoidRootPart.Position)
        end
    end
    print("⏹ Фарм остановлен")
end

