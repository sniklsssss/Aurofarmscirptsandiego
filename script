local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local FLY_SPEED = 70
local HOLD_DURATION = 2

-- Маршрут (оставляем тот же)
local route = {
    { pos = Vector3.new(6887.71875, 17.218589782714844, 26.872846603393555) },
    { pos = Vector3.new(6809.7509765625, 17.416330337524414, 22.777130126953125),
      holdAction = { duration = 2, repeats = 5, totalPause = 15 } },
    -- ... (остальные точки такие же, сокращаю для краткости)
    { pos = Vector3.new(6850.42822265625, 17.416536331176758, -41.9425048828125) },
}

local isRunning = false
local stopRequested = false
local currentTween = nil

-- Эмуляция клика и удержания в центре экрана
local function clickAndHoldCenter(holdDuration)
    local mouse = Player:GetMouse()
    if not mouse then return end
    local screenSize = game:GetService("GuiService"):GetScreenResolution()
    local centerX, centerY = screenSize.X / 2, screenSize.Y / 2
    mouse.Move(Vector2.new(centerX, centerY))
    mouse.Button1Down()
    task.wait(holdDuration)
    mouse.Button1Up()
end

-- Летающее перемещение (как в прошлый раз)
local function flyToPoint(targetPos, speed)
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
    end

    local currentCF = hrp.CFrame
    local targetCF = CFrame.new(targetPos) * CFrame.Angles(0, currentCF.Y, 0)
    local distance = (targetPos - hrp.Position).Magnitude
    local duration = distance / speed
    if duration < 0.1 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = { CFrame = targetCF }
    currentTween = TweenService:Create(hrp, tweenInfo, goal)

    local completed = false
    currentTween.Completed:Connect(function() completed = true end)
    currentTween:Play()

    while not completed and isRunning and not stopRequested do
        task.wait(0.05)
    end

    if stopRequested then
        currentTween:Cancel()
        return false
    end
    return true
end

-- Выполнение действия (клик в центр)
local function performHold(action)
    if not action then return end
    local duration = action.duration or 2
    local repeats = action.repeats or 1
    local totalPause = action.totalPause or (duration * repeats)

    for i = 1, repeats do
        if not isRunning or stopRequested then break end
        clickAndHoldCenter(duration)
        if not isRunning or stopRequested then break end
        if i < repeats then
            task.wait(0.2)
        end
    end

    local remaining = totalPause - (duration * repeats)
    if remaining > 0 and isRunning and not stopRequested then
        task.wait(remaining)
    end
end

-- Основной цикл
local function farmCycle()
    while isRunning and not stopRequested do
        for _, step in ipairs(route) do
            if not isRunning or stopRequested then break end
            local ok = flyToPoint(step.pos, FLY_SPEED)
            if not ok then break end
            if step.holdAction and isRunning and not stopRequested then
                performHold(step.holdAction)
            end
            task.wait(0.2)
        end
        if isRunning and not stopRequested then
            task.wait(0.5)
        end
    end
end

-- Запуск/остановка
local function startFarm()
    if isRunning then return end
    isRunning = true
    stopRequested = false
    task.spawn(farmCycle)
end

local function stopFarm()
    if not isRunning then return end
    isRunning = false
    stopRequested = true
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

