-- ------------------------------------------------------------
--  Взаимодействие через ProximityPrompt (без клавиатуры)
-- ------------------------------------------------------------
local function interactAtPosition(holdDuration)
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position

    -- Ищем ProximityPrompt в радиусе 10 студий
    local found = false
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local parent = prompt.Parent
            if parent then
                local promptPos = parent:FindFirstChild("Position") and parent.Position
                if promptPos then
                    local dist = (promptPos - pos).Magnitude
                    if dist < 10 then
                        pcall(function()
                            prompt:InputHoldBegin()
                            task.wait(holdDuration)
                            prompt:InputHoldEnd()
                        end)
                        found = true
                    end
                end
            end
        end
    end

    if found then return true end

    -- Если нет промптов, ищем ClickDetector
    for _, det in ipairs(workspace:GetDescendants()) do
        if det:IsA("ClickDetector") then
            local parent = det.Parent
            if parent then
                local detPos = parent:FindFirstChild("Position") and parent.Position
                if detPos then
                    local dist = (detPos - pos).Magnitude
                    if dist < 10 then
                        pcall(function()
                            det:FireClick(Player.Mouse)
                        end)
                        found = true
                    end
                end
            end
        end
    end

    if found then
        task.wait(holdDuration) -- имитация удержания
        return true
    end

    -- Если ничего не нашли, просто ждём
    task.wait(holdDuration)
    return false
end

-- ------------------------------------------------------------
--  Плавное перемещение (летающее, без переворотов)
-- ------------------------------------------------------------
local function flyToPoint(targetPos, speed)
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
    end

    local currentCF = hrp.CFrame
    local targetCF = CFrame.new(targetPos) * CFrame.Angles(0, currentCF.Y, 0)

    local distance = (targetPos - hrp.Position).Magnitude
    local duration = distance / speed
    if duration < 0.1 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = { CFrame = targetCF }
    currentTween = TweenService:Create(hrp, tweenInfo, goal)

    local completed = false
    currentTween.Completed:Connect(function()
        completed = true
    end)

    currentTween:Play()

    while not completed and isRunning and not stopRequested do
        task.wait(0.05)
    end

    if stopRequested then
        currentTween:Cancel()
        return false
    end

    return true
}

-- ------------------------------------------------------------
--  Выполнение действия с повторами
-- ------------------------------------------------------------
local function performHold(action)
    if not action then return end
    local duration = action.duration or 2
    local repeats = action.repeats or 1
    local totalPause = action.totalPause or (duration * repeats)

    for i = 1, repeats do
        if not isRunning or stopRequested then break end
        interactAtPosition(duration)
        if not isRunning or stopRequested then break end
        if i < repeats then
            task.wait(0.2)
        end
    end

    local remaining = totalPause - (duration * repeats)
    if remaining > 0 and isRunning and not stopRequested then
        task.wait(remaining)
    end
end

-- ------------------------------------------------------------
--  Основной цикл
-- ------------------------------------------------------------
local function farmCycle()
    while isRunning and not stopRequested do
        for _, step in ipairs(route) do
            if not isRunning or stopRequested then break end
            local ok = flyToPoint(step.pos, FLY_SPEED)
            if not ok then break end
            if step.holdAction and isRunning and not stopRequested then
                performHold(step.holdAction)
            end
            task.wait(0.2)
        end
        if isRunning and not stopRequested then
            task.wait(0.5)
        end
    end
end

-- ------------------------------------------------------------
--  Запуск / остановка
-- ------------------------------------------------------------
local function startFarm()
    if isRunning then return end
    isRunning = true
    stopRequested = false
    task.spawn(farmCycle)
end

local function stopFarm()
    if not isRunning then return end
    isRunning = false
    stopRequested = true
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

