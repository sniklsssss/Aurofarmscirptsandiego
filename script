-- Вспомогательная функция для спама в чат
local function spamChat(msg)
    local sayMsg = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
    if sayMsg then
        pcall(function() sayMsg:FireServer(msg, "All") end)
    end
end

-- Функция телепортации всех игроков в точку
local function teleportAllToMe()
    local myChar = Player.Character
    if not myChar then return end
    local root = myChar:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = root.Position
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= Player then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(math.random(-10,10), 0, math.random(-10,10)))
            end
        end
    end
end

-- Функция спама удалённых событий
local function spamRemoteEvents()
    for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            pcall(function()
                if child:IsA("RemoteEvent") then
                    child:FireServer("ban", "me", "please", "spam")
                else
                    child:InvokeServer("spam")
                end
            end)
        end
    end
end

-- Функция массового создания объектов в Workspace
local function spawnObjects()
    for i = 1, 50 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(1,1,1)
        part.Position = Vector3.new(math.random(-5000,5000), math.random(10,100), math.random(-5000,5000))
        part.Anchored = true
        part.Name = "BanPart" .. i
        part.Parent = Workspace
