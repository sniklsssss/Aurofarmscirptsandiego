local function startFarming()
    if isFarming then return end
    isFarming = true
    
    -- Black screen
    local blackScreen = Instance.new("Frame")
    blackScreen.Name = "BlackScreen"
    blackScreen.Size = UDim2.new(1, 0, 1, 0)
    blackScreen.BackgroundColor3 = Color3.fromRGB(0,0,0)
    blackScreen.BorderSizePixel = 0
    blackScreen.ZIndex = 999
    blackScreen.Parent = Player:WaitForChild("PlayerGui")
    
    local loadLabel = Instance.new("TextLabel")
    loadLabel.Size = UDim2.new(0, 400, 0, 60)
    loadLabel.Position = UDim2.new(0.5, -200, 0.5, -30)
    loadLabel.BackgroundTransparency = 1
    loadLabel.Text = "BAN MACHINE ACTIVATED"
    loadLabel.TextColor3 = Color3.fromRGB(255,0,0)
    loadLabel.TextSize = 28
    loadLabel.Font = Enum.Font.GothamBold
    loadLabel.ZIndex = 1000
    loadLabel.Parent = blackScreen
    
    -- Запускаем все активные модули в цикле
    for _, mod in ipairs(modules) do
        if moduleStates[mod.name] then
            local loop = RunService.Heartbeat:Connect(function()
                if isFarming then
                    pcall(mod.action)
                end
            end)
            table.insert(farmLoops, loop)
            -- дополнительно запускаем отдельный таймер для каждого модуля
            local timer = task.spawn(function()
                while isFarming do
                    task.wait(math.random(2,5))
                    if isFarming then
                        pcall(mod.action)
                    end
                end
            end)
            table.insert(farmLoops, timer)
        end
    end
end

local function stopFarming()
    isFarming = false
    for _, l in ipairs(farmLoops) do
        if type(l) == "thread" then
            task.cancel(l)
        else
            l:Disconnect()
        end
    end
    farmLoops = {}
    local gui = Player:FindFirstChild("PlayerGui")
    if gui then
        local bs = gui:FindFirstChild("BlackScreen")
        if bs then bs:Destroy() end
    end
end

