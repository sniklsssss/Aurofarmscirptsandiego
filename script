-- ------------------------------------------------------------
--  Эмуляция взаимодействия
-- ------------------------------------------------------------
local function activateInteraction(holdDuration)
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position

    -- Ищем ProximityPrompt в радиусе 10 студий
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local promptPos = prompt.Parent and prompt.Parent:FindFirstChild("Position") and prompt.Parent.Position
            if promptPos and (promptPos - pos).Magnitude < 10 then
                for i = 1, math.floor(holdDuration / 0.1) do
                    if not isRunning or stopRequested then break end
                    VirtualInput:SendKeyEvent(true, KEY_E, false, game)
                    task.wait(0.1)
                    VirtualInput:SendKeyEvent(false, KEY_E, false, game)
                    task.wait(0.05)
                end
                return true
            end
        end
    end

    -- Если нет ProximityPrompt, ищем ClickDetector
    for _, det in ipairs(workspace:GetDescendants()) do
        if det:IsA("ClickDetector") then
            local detPos = det.Parent and det.Parent:FindFirstChild("Position") and det.Parent.Position
            if detPos and (detPos - pos).Magnitude < 10 then
                pcall(function() det:FireClick(Player.Mouse) end)
                task.wait(holdDuration)
                return true
            end
        end
    end

    task.wait(holdDuration)
    return false
end

-- ------------------------------------------------------------
--  Перемещение с огромной скоростью
-- ------------------------------------------------------------
local function flyToPoint(targetPos)
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
    end

    local currentCF = hrp.CFrame
    local targetCF = CFrame.new(targetPos) * CFrame.Angles(0, currentCF.Y, 0)

    local distance = (targetPos - hrp.Position).Magnitude
    local duration = distance / SPEED
    if duration < 0.01 then duration = 0.01 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = { CFrame = targetCF }
    currentTween = TweenService:Create(hrp, tweenInfo, goal)

    local completed = false
    currentTween.Completed:Connect(function() completed = true end)
    currentTween:Play()

    while not completed and isRunning and not stopRequested do
        task.wait(0.01)
    end

    if stopRequested then
        currentTween:Cancel()
        return false
    end
    return true
end

-- ------------------------------------------------------------
--  Выполнение действия
-- ------------------------------------------------------------
local function performHold(action)
    if not action then return end
    local duration = action.duration or 2
    local repeats = action.repeats or 1
    local totalPause = action.totalPause or (duration * repeats)

    for i = 1, repeats do
        if not isRunning or stopRequested then break end
        activateInteraction(duration)
        if not isRunning or stopRequested then break end
        if i < repeats then
            task.wait(0.2)
        end
    end

    local remaining = totalPause - (duration * repeats)
    if remaining > 0 and isRunning and not stopRequested then
        task.wait(remaining)
    end
end

-- ------------------------------------------------------------
--  Анти-AFK
-- ------------------------------------------------------------
local function startAfk()
    if afkThread then return end
    afkThread = task.spawn(function()
        while isRunning and not stopRequested do
            task.wait(15)
            if not isRunning or stopRequested then break end
            local char = Player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos = hrp.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0.5, 0, 0))
                    task.wait(0.05)
                    hrp.CFrame = CFrame.new(pos)
                end
            end
        end
    end)
end

local function stopAfk()
    if afkThread then
        task.cancel(afkThread)
        afkThread = nil
    end
end

-- ------------------------------------------------------------
--  Основной цикл
-- ------------------------------------------------------------
local function farmCycle()
    while isRunning and not stopRequested do
        for _, step in ipairs(route) do
            if not isRunning or stopRequested then break end
            local ok = flyToPoint(step.pos)
            if not ok then break end
            if step.holdAction and isRunning and not stopRequested then
                performHold(step.holdAction)
            end
            task.wait(0.1)
        end
        if isRunning and not stopRequested then
            task.wait(0.5)
        end
    end
end

-- ------------------------------------------------------------
--  Запуск / остановка
-- ------------------------------------------------------------
local function startFarm()
    if isRunning then return end
    isRunning = true
    stopRequested = false
    task.spawn(farmCycle)
    startAfk()
end

local function stopFarm()
    if not isRunning then return end
    isRunning = false
    stopRequested = true
    stopAfk()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    local char = Player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

