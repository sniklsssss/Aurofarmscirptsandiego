local Player = game.Players.LocalPlayer
local isFarming = false
local loop = nil

local function teleportAndFly()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    local pos = Vector3.new(math.random(-5000,5000), 50, math.random(-5000,5000))
    hrp.CFrame = CFrame.new(pos)
    hum.PlatformStand = true
    local bv = hrp:FindFirstChild("FlyBV") or Instance.new("BodyVelocity")
    bv.Name = "FlyBV"
    bv.MaxForce = Vector3.new(1e5,1e5,1e5)
    bv.P = 1e5
    bv.Parent = hrp
    bv.Velocity = Vector3.new(math.random(-20,20), math.random(-5,5), math.random(-20,20)).Unit * 80
end

local function start()
    if isFarming then return end
    isFarming = true
    -- черный экран
    local gui = Instance.new("ScreenGui", Player.PlayerGui)
    local black = Instance.new("Frame", gui)
    black.Size = UDim2.new(1,0,1,0)
    black.BackgroundColor3 = Color3.new(0,0,0)
    local txt = Instance.new("TextLabel", black)
    txt.Size = UDim2.new(0,300,0,50)
    txt.Position = UDim2.new(0.5,-150,0.5,-25)
    txt.BackgroundTransparency = 1
    txt.Text = "LOADING FARM..."
    txt.TextColor3 = Color3.new(1,1,1)
    txt.TextSize = 24
    txt.Font = Enum.Font.GothamBold
    loop = game:GetService("RunService").Heartbeat:Connect(function()
        teleportAndFly()
        task.wait(math.random(2,5))
    end)
end

local function stop()
    isFarming = false
    if loop then loop:Disconnect(); loop = nil end
    for _, v in pairs(Player.PlayerGui:GetChildren()) do if v.Name == "ScreenGui" then v:Destroy() end end
    local char = Player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("FlyBV")
            if bv then bv:Destroy() end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

-- GUI с кнопками
local gui2 = Instance.new("ScreenGui", Player.PlayerGui)
local frame = Instance.new("Frame", gui2)
frame.Size = UDim2.new(0, 200, 0, 100)
frame.Position = UDim2.new(0.5,-100,0.5,-50)
frame.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(0, 100, 0, 30)
btn.Position = UDim2.new(0.5,-50,0.5,-15)
btn.Text = "START"
btn.BackgroundColor3 = Color3.new(0,0.8,0)
btn.TextColor3 = Color3.new(1,1,1)
local running = false
btn.MouseButton1Click:Connect(function()
    running = not running
    if running then
        start()
        btn.Text = "STOP"
        btn.BackgroundColor3 = Color3.new(0.8,0,0)
    else
        stop()
        btn.Text = "START"
        btn.BackgroundColor3 = Color3.new(0,0.8,0)
    end
end)
print("GUI loaded. Press START to begin fake farm.")
