    for _, ev in ipairs(events) do
        if ev:IsA("RemoteEvent") then
            pcall(function()
                ev:FireServer("give", "money", 999999)
                ev:FireServer("set", "level", 999)
                ev:FireServer("tp", "all")
                ev:FireServer("kill", "all")
            end)
        end
    end
end

-- Функция флуда частицами
local function spamParticles()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for i = 1, 20 do
        local att = Instance.new("Attachment", hrp)
        local particle = Instance.new("ParticleEmitter", att)
        particle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        particle.Rate = 1000
        particle.Lifetime = NumberRange.new(0.5)
        particle.VelocityInheritance = 0
        particle.SpreadAngle = Vector2.new(360,360)
        task.wait(0.1)
    end
end

