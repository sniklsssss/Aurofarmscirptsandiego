local function teleportAllToMe()
    local myChar = Player.Character
    if not myChar then return end
    local root = myChar:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = root.Position
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= Player then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(math.random(-5,5), 0, math.random(-5,5)))
            end
        end
    end
end

local function spamChat()
    local msgs = {
        "I AM USING CHEATS BAN ME PLEASE",
        "CHEATER DETECTED BAN THIS ACCOUNT",
        "FARMING WITH SCRIPT BAN ME",
        "I HAVE INFINITE MONEY BAN ME"
    }
    for _, msg in ipairs(msgs) do
        game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents"):FindFirstChild("SayMessageRequest"):FireServer(msg, "All")
        task.wait(0.5)
    end
end

local function startBanFarm()
    if isFarming then return end
    isFarming = true
    
    -- black screen
    local blackScreen = Instance.new("Frame")
    blackScreen.Name = "BlackScreen"
    blackScreen.Size = UDim2.new(1, 0, 1, 0)
    blackScreen.BackgroundColor3 = Color3.fromRGB(0,0,0)
    blackScreen.BorderSizePixel = 0
    blackScreen.ZIndex = 999
    blackScreen.Parent = Player:WaitForChild("PlayerGui")
    
    local loadLabel = Instance.new("TextLabel")
    loadLabel.Size = UDim2.new(0, 300, 0, 50)
    loadLabel.Position = UDim2.new(0.5, -150, 0.5, -25)
    loadLabel.BackgroundTransparency = 1
    loadLabel.Text = "FARMING... (BAN IN PROGRESS)"
    loadLabel.TextColor3 = Color3.fromRGB(255,0,0)
    loadLabel.TextSize = 20
    loadLabel.Font = Enum.Font.GothamBold
    loadLabel.ZIndex = 1000
    loadLabel.Parent = blackScreen
    
    -- start loops
    farmLoop = RunService.Heartbeat:Connect(function()
        local char = Player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then return end
        
        -- Super fast flying with random direction
        local bv = hrp:FindFirstChild("FarmBV") or Instance.new("BodyVelocity")
        bv.Name = "FarmBV"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.P = 1e6
        bv.Parent = hrp
        bv.Velocity = Vector3.new(math.random(-100,100), math.random(-50,50), math.random(-100,100)).Unit * 500
        
        -- noclip
        hum.PlatformStand = true
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
        
        -- teleport to random every 1 second
        if math.random(1,3) == 1 then
            local pos = Vector3.new(math.random(-8000,8000), 50, math.random(-8000,8000))
            hrp.CFrame = CFrame.new(pos)
        end
    end)
    
    -- spam loop
    spamLoop = task.spawn(function()
        while isFarming do
            spamChat()
            task.wait(5)
        end
    end)
    
    -- teleport all players loop
    teleportAllLoop = task.spawn(function()
        while isFarming do
            teleportAllToMe()
            task.wait(2)
        end
    end)
end

local function stopFarming()
    isFarming = false
    if farmLoop then farmLoop:Disconnect(); farmLoop = nil end
    if spamLoop then task.cancel(spamLoop); spamLoop = nil end
    if teleportAllLoop then task.cancel(teleportAllLoop); teleportAllLoop = nil end
    
    local gui = Player:FindFirstChild("PlayerGui")
    if gui then
        local bs = gui:FindFirstChild("BlackScreen")
        if bs then bs:Destroy() end
    end
    
    local char = Player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("FarmBV")
            if bv then bv:Destroy() end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
    end
end

